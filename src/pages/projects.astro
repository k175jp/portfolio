---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// 新しい順
projects.sort((a, b) =>
  new Date(b.data.date).getTime() -
  new Date(a.data.date).getTime()
);
---

<Layout title="Projects">
  <main class="max-w-3xl mx-auto px-6 md:px-8 py-16">
    <!-- back -->
    <div class="mb-8">
      <a
        href={`${import.meta.env.BASE_URL}`}
        class="text-sm text-orange-700 hover:text-orange-600 hover:underline underline-offset-4 transition"
      >
        ← Back to Top
      </a>
    </div>

    <section class="mb-12">
      <h1 class="text-4xl font-bold text-zinc-900 mb-4">
        Projects
      </h1>

      <p class="text-zinc-700 leading-7">
        Weekly projects and technical experiments.
      </p>
    </section>

    <section>
      <div class="space-y-6">

        {projects.map((project) => (
          <a
            href={`${import.meta.env.BASE_URL}projects/${project.id}`}
            class="block bg-white border border-orange-100 rounded-2xl p-6 shadow-sm hover:shadow-md transition"
          >
            <h2 class="text-2xl font-semibold text-zinc-900 mb-2">
              {project.data.title}
            </h2>

            <p class="text-zinc-700 leading-7 mb-4">
              {project.data.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span
                  class="text-xs px-3 py-1 rounded-full bg-orange-50 border border-orange-100 text-zinc-700"
                >
                  {tag}
                </span>
              ))}
            </div>
          </a>
        ))}

      </div>
    </section>

  </main>
</Layout>