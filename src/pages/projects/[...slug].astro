---
import Layout from "../../layouts/Layout.astro";

import {
  getCollection,
  render,
} from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },
    props: {
      project,
    },
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);
---

<Layout title={project.data.title}>
  <main class="max-w-3xl mx-auto px-6 md:px-8 py-16">

    <!-- back -->
    <div class="mb-8">
      <a
        href="/projects"
        class="text-sm text-orange-700 hover:text-orange-600 hover:underline underline-offset-4 transition"
      >
        ← Back to Projects
      </a>
    </div>

    <!-- article -->
    <article class="bg-white border border-orange-100 rounded-2xl p-8 shadow-sm">

      <!-- title -->
      <header class="mb-8">

        <h1 class="text-4xl font-bold text-zinc-900 mb-4">
          {project.data.title}
        </h1>

        <p class="text-zinc-700 leading-7 mb-6">
          {project.data.description}
        </p>

        <!-- tags -->
        <div class="flex flex-wrap gap-2 mb-6">
          {project.data.tags.map((tag) => (
            <span
              class="text-xs px-3 py-1 rounded-full bg-orange-50 border border-orange-100 text-zinc-700"
            >
              {tag}
            </span>
          ))}
        </div>

        <!-- github -->
        {project.data.github && (
          <a
            href={project.data.github}
            target="_blank"
            class="inline-flex items-center text-orange-700 hover:text-orange-600 hover:underline underline-offset-4 transition"
          >
            View on GitHub →
          </a>
        )}

      </header>

      <!-- markdown -->
      <div class="prose prose-zinc max-w-none prose-headings:text-zinc-900 prose-p:text-zinc-700 prose-li:text-zinc-700">
        <Content />
      </div>
      <div
  class="
    prose
    prose-zinc
    max-w-none

    prose-h1:text-4xl
    prose-h1:font-bold
    prose-h1:text-zinc-900

    prose-p:text-zinc-700
  "
>
  <Content />
</div>

    </article>

  </main>
</Layout>