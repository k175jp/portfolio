---
import Layout from "../layouts/Layout.astro";
---

<Layout title="k175jp Portfolio">
  <main class="max-w-3xl mx-auto px-8 py-16">
    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h1 class="text-4xl font-bold text-zinc-900 mb-4">
        Hi there 👋
      </h1>

      <p class="text-lg text-zinc-700 mb-4">
        Web Security Engineer
      </p>

      <p class="text-zinc-700 leading-7 mb-2">
        Currently working in Web Application Security and vulnerability assessment.
      </p>

      <p class="text-zinc-700 leading-7">
        Interested in:
      </p>

      <ul class="list-disc ml-6 mt-3 space-y-1 text-zinc-700">
        <li>Backend Development</li>
        <li>Cloud Infrastructure</li>
        <li>AppSec</li>
        <li>DevSecOps</li>
        <li>Secure System Design</li>
      </ul>
    </section>

    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900 mb-4">
        About Me
      </h2>

      <p class="text-zinc-700 leading-7 mb-4">
        I have experience with:
      </p>

      <ul class="list-disc ml-6 space-y-1 text-zinc-700 mb-6">
        <li>Web vulnerability assessment</li>
        <li>API security testing</li>
        <li>Authentication / Authorization testing</li>
        <li>Modern web applications</li>
        <li>Cloud-native environments</li>
      </ul>

      <p class="text-zinc-700 leading-7 mb-4">
        Background in:
      </p>

      <ul class="list-disc ml-6 space-y-1 text-zinc-700 mb-6">
        <li>Web</li>
        <li>Infrastructure</li>
        <li>Networking</li>
        <li>Cloud</li>
        <li>Security</li>
        <li>CTF</li>
      </ul>

    </section>

    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900 mb-6">
        Tech Stack
      </h2>

      <div class="space-y-10">
        <div>
          <h3 class="text-xl font-medium text-zinc-900 mb-2">
            Languages
          </h3>

          <ul class="list-disc ml-6 space-y-1 text-zinc-700">
            <li>TypeScript</li>
            <li>JavaScript</li>
            <li>Python</li>
            <li>PHP</li>
            <li>Java</li>
            <li>Rust</li>
            <li>C</li>
            <li>SQL</li>
            <li>Shell Script</li>
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-medium text-zinc-900 mb-2">
            Frontend
          </h3>

          <ul class="list-disc ml-6 space-y-1 text-zinc-700">
            <li>React</li>
            <li>Next.js</li>
            <li>Svelte</li>
            <li>Astro</li>
            <li>Tailwind CSS</li>
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-medium text-zinc-900 mb-2">
            Backend / API
          </h3>

          <ul class="list-disc ml-6 space-y-1 text-zinc-700">
            <li>Django</li>
            <li>FastAPI</li>
            <li>Flask</li>
            <li>REST API</li>
            <li>JWT Authentication</li>
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-medium text-zinc-900 mb-2">
            Infrastructure / DevOps
          </h3>

          <ul class="list-disc ml-6 space-y-1 text-zinc-700">
            <li>AWS</li>
            <li>Docker</li>
            <li>Linux</li>
            <li>GitHub Actions</li>
            <li>Cloudflare</li>
          </ul>
        </div>

        <div>
          <h3 class="text-xl font-medium text-zinc-900 mb-2">
            Security
          </h3>

          <ul class="list-disc ml-6 space-y-1 text-zinc-700">
            <li>Web Security</li>
            <li>API Security</li>
            <li>OWASP Top 10</li>
            <li>Authentication / Authorization</li>
            <li>Secure Design</li>
            <li>CTF</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900 mb-4">
        Currently Learning
      </h2>

      <ul class="list-disc ml-6 space-y-1 text-zinc-700">
        <li>Terraform</li>
        <li>Kubernetes</li>
        <li>OAuth / OpenID Connect</li>
        <li>Cloud Security</li>
        <li>Secure Architecture</li>
      </ul>
    </section>

    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900 mb-4">
        Interests
      </h2>

      <ul class="list-disc ml-6 space-y-1 text-zinc-700">
        <li>Web Security</li>
        <li>Backend Development</li>
        <li>Cloud Infrastructure</li>
        <li>CTF</li>
        <li>Climbing / Bouldering</li>
      </ul>
    </section>

    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900 mb-4">
        Projects
      </h2>

      <p class="text-zinc-700">
        See:
        <a
          href="/projects"
          class="text-orange-700 hover:text-orange-600 hover:underline underline-offset-4 transition ml-1"
        >
          Project List
        </a>
      </p>
    </section>

    <section class="mb-10 bg-white border border-orange-100 rounded-2xl p-6 shadow-sm">
      <h2 class="text-2xl font-semibold text-zinc-900 mb-4">
        Links
      </h2>

      <ul class="list-disc ml-6 space-y-1 text-zinc-700">
        <li>
          <a
            href="https://zenn.dev/k175"
            target="_blank"
            class="text-orange-700 hover:text-orange-600 hover:underline underline-offset-4 transition"
          >
            Zenn
          </a>
        </li>

        <li>
          <a
            href="https://github.com/k175jp"
            target="_blank"
            class="text-orange-700 hover:text-orange-600 hover:underline underline-offset-4 transition"
          >
            GitHub
          </a>
        </li>
      </ul>
    </section>
  </main>
</Layout>